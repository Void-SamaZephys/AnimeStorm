<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= anime.baslik %> <%= bolum.baslik %> - <%= siteAdi %></title>
    <style>
        body { background: #0b0c10; color: #c5c6c7; font-family: sans-serif; text-align: center; padding: 20px; }
        .nav { margin-bottom: 20px; text-align: left; max-width: 800px; margin-left: auto; margin-right: auto; }
        .nav a { color: #66fcf1; text-decoration: none; font-weight: bold; }
        .video-container { position: relative; padding-bottom: 56.25%; height: 0; max-width: 800px; margin: 20px auto; border: 2px solid #45a29e; border-radius: 8px; overflow: hidden; }
        .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
        .episodes { margin-top: 20px; }
        .episodes a { color: #0b0c10; background: #66fcf1; padding: 8px 15px; text-decoration: none; border-radius: 4px; margin: 5px; display: inline-block; font-weight: bold; }
        .episodes a:hover { background: #45a29e; color: #fff; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/">← <%= siteAdi %> Ana Sayfaya Dön</a>
    </div>
    <h2><%= anime.baslik %> - <%= bolum.baslik %></h2>
    
    <div class="video-container">
        <iframe src="<%= bolum.embed %>" allowfullscreen></iframe>
    </div>

    <div class="episodes">
        <h3>Bölümler:</h3>
        <% anime.bolumler.forEach(b => { %>
            <a href="/watch/<%= anime.id %>/<%= b.no %>">Bölüm <%= b.no %></a>
        <% }) %>
    </div>
</body>
</html>

