<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= siteAdi %> - Anime İzleme Platformu</title>
    <style>
        body { background: #0b0c10; color: #c5c6c7; font-family: sans-serif; margin: 0; padding: 20px; }
        .header { text-align: center; padding: 20px 0; border-bottom: 2px solid #66fcf1; margin-bottom: 30px; }
        .logo { color: #66fcf1; font-size: 32px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; }
        .grid { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }
        .card { background: #1f2833; padding: 15px; border-radius: 8px; width: 200px; text-align: center; border: 1px solid #45a29e; }
        .card img { width: 100%; border-radius: 5px; }
        .card h3 { color: #fff; font-size: 18px; margin: 10px 0; }
        .card a { display: inline-block; padding: 8px 12px; background: #66fcf1; color: #0b0c10; text-decoration: none; font-weight: bold; border-radius: 4px; margin-top: 5px; }
        .card a:hover { background: #45a29e; color: #fff; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">⚡ <%= siteAdi %> ⚡</div>
    </div>
    <div class="grid">
        <% animeler.forEach(anime => { %>
            <div class="card">
                <img src="<%= anime.resim %>" alt="<%= anime.baslik %>">
                <h3><%= anime.baslik %></h3>
                <a href="/watch/<%= anime.id %>/1">1. Bölümü İzle</a>
            </div>
        <% }) %>
    </div>
</body>
</html>

